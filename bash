# 1. Inicializar el repositorio Git local
git init

# 2. Agregar todos los archivos permitidos al área de preparación
git add .

# 3. Guardar tu primer conjunto de cambios (Commit)
git commit -m "Initial commit: Sistema de Subasta Inversa Alimentos HCHF4 completo"

# 4. Renombrar la rama principal a 'main' (Estándar global de GitHub)
git branch -M main
